# ──────────────────────────────────────────────────────────────────────────────
# .env.prod.example — Production environment (VPS + real domain)
# Copy to .env on the VPS and fill in all values before deploying.
# Never commit .env to git.
# ──────────────────────────────────────────────────────────────────────────────

# ── Telegram Bot ──────────────────────────────────────────────────────────────
BOT_TOKEN=1234567890:ABCDEFGxxxxxxxxxxxxxxxxxxxxxxxx

# ── Webhook ───────────────────────────────────────────────────────────────────
# IMPORTANT: must match your real domain. Caddy handles SSL automatically.
WEBHOOK_BASE_URL=https://yourdomain.com
WEBHOOK_PATH=/telegram/webhook
WEBHOOK_SECRET=generate_with__openssl_rand__hex_32

# Used by Caddy to obtain Let's Encrypt certificate. No https://, just the domain.
DOMAIN=yourdomain.com

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://botuser:STRONG_PASSWORD_HERE@db/botdb
POSTGRES_USER=botuser
POSTGRES_PASSWORD=STRONG_PASSWORD_HERE
POSTGRES_DB=botdb

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Bot roles ─────────────────────────────────────────────────────────────────
# Regular group: -XXXXXXX  |  Supergroup: -100XXXXXXX
OPERATOR_GROUP_ID=-XXXXXXX
ADMIN_TELEGRAM_ID=YOUR_TELEGRAM_USER_ID

# ── Robokassa (production) ────────────────────────────────────────────────────
ROBOKASSA_LOGIN=your_robokassa_login
ROBOKASSA_PASS1=your_robokassa_pass1
ROBOKASSA_PASS2=your_robokassa_pass2
ROBOKASSA_IS_TEST=false            # MUST be false in production!

# ── Backup ────────────────────────────────────────────────────────────────────
# Create a private Telegram group, add the bot, get its chat_id.
BACKUP_CHAT_ID=-XXXXXXXXXX
