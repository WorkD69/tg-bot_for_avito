# ──────────────────────────────────────────────────────────────────────────────
# TG Bot for Avito — environment configuration template
# Copy to .env and fill in your values. Never commit .env to git.
# ──────────────────────────────────────────────────────────────────────────────

# ── Telegram Bot ──────────────────────────────────────────────────────────────
BOT_TOKEN=                        # Get from @BotFather

# ── Webhook ───────────────────────────────────────────────────────────────────
# LOCAL DEV (ngrok): WEBHOOK_BASE_URL=https://xxxx.ngrok-free.app
# PRODUCTION: WEBHOOK_BASE_URL=https://yourdomain.com
WEBHOOK_BASE_URL=https://xxxx.ngrok-free.app
WEBHOOK_PATH=/telegram/webhook
WEBHOOK_SECRET=change_me_to_random_string

# DOMAIN is used by Caddy for SSL certificate (production only, no https://)
# Leave empty for local dev (ngrok doesn't need Caddy)
DOMAIN=

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://botuser:botpass@db/botdb
POSTGRES_USER=botuser
POSTGRES_PASSWORD=botpass
POSTGRES_DB=botdb

# ── Redis (FSM state storage) ─────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Bot roles ─────────────────────────────────────────────────────────────────
# OPERATOR_GROUP_ID: negative chat_id of the operator supergroup.
# Regular groups: -XXXXXXX (no -100 prefix)
# Supergroups:    -100XXXXXXX
# To get the id: add @userinfobot to the group, it will show the chat_id.
OPERATOR_GROUP_ID=-XXXXXXX

ADMIN_TELEGRAM_ID=                # Your personal Telegram user_id (numeric)

# ── Robokassa ─────────────────────────────────────────────────────────────────
# Leave ROBOKASSA_LOGIN empty to use manual payment mode ("Ya oplatil" button).
# Fill all three for real Robokassa integration.
ROBOKASSA_LOGIN=
ROBOKASSA_PASS1=
ROBOKASSA_PASS2=
ROBOKASSA_IS_TEST=true            # Set false only with real Robokassa account

# ── Payouts ───────────────────────────────────────────────────────────────────
# Percentage of order payment_amount that goes to the operator (default: 80%).
# Stored per-earning at creation time — changing this won't recalculate old records.
OPERATOR_PAYOUT_PERCENT=80.0

# ── Backup ────────────────────────────────────────────────────────────────────
# Telegram group id where daily DB backups are sent (bot must be a member).
# Leave empty to disable backup sending (backup container still runs, but won't send).
BACKUP_CHAT_ID=
