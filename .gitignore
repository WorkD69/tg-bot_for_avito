# Environment — never commit real credentials
.env
.env.prod

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Docker volumes / local state
*.log

# Pre-downloaded pip wheels (large binaries — use pip install normally)
wheels/

# Temp / dev artefacts
tmp/
*.db

# OS
.DS_Store
Thumbs.db
*.lnk

# Browser automation artifacts
.playwright-mcp/

# Root-level screenshots and temp scripts
/*.png
tmp_ssh*.py

# pip shell redirect artefacts (Windows: pip install "pkg>=x.x" misparses as file redirect)
=*
